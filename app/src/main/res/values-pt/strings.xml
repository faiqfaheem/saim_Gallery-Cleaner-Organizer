    <!-- Daily Localized Notifications -->
    <string name="notif_channel_name">Lembretes diários da galeria</string>
    <string name="notif_channel_desc">Lembretes diários para limpar duplicadas, fotos borradas e liberar espaço.</string>
    <string name="notif_daily_title_1">Libere espaço com um toque</string>
    <string name="notif_daily_msg_1">Use a Limpeza Inteligente IA para achar fotos duplicadas, borradas e capturas antigas.</string>
    <string name="notif_daily_title_2">Fotos duplicadas ocupando memória?</string>
    <string name="notif_daily_msg_2">Cópias idênticas consomem gigabytes sem você notar. Escaneie e mantenha só a original.</string>
    <string name="notif_daily_title_3">Guarde apenas a foto mais nítida</string>
    <string name="notif_daily_msg_3">Tirou várias fotos seguidas? Deixe a IA escolher a melhor e remover as extras.</string>
    <string name="notif_daily_title_4">Limpe fotos borradas e tremidas</string>
    <string name="notif_daily_msg_4">Identifique automaticamente imagens fora de foco para manter sua galeria impecável.</string>
    <string name="notif_daily_title_5">Veja a pontuação de saúde da galeria</string>
    <string name="notif_daily_msg_5">Confira seu índice de saúde IA hoje e recupere espaço com recomendações inteligentes.</string>
    <string name="notif_daily_title_6">Capturas de tela antigas acumulando?</string>
    <string name="notif_daily_msg_6">Revise prints antigos que não precisa mais e apague tudo em segundos.</string>
    <string name="notif_daily_title_7">Encontre vídeos pesados rapidamente</string>
    <string name="notif_daily_msg_7">Vídeos grandes enchem seu celular rápido. Veja os maiores arquivos para liberar espaço já.</string>
    <string name="notif_daily_title_8">Limpe mídias recebidas no WhatsApp</string>
    <string name="notif_daily_msg_8">Memes e vídeos encaminhados ocupam muito espaço. Limpe o que não precisa facilmente.</string>
    <string name="notif_daily_title_9">Fotos muito escuras ou estouradas?</string>
    <string name="notif_daily_msg_9">A IA detecta fotos com má iluminação automaticamente para você organizar sem esforço.</string>
    <string name="notif_daily_title_10">Explore seus álbuns organizados por IA</string>
    <string name="notif_daily_msg_10" formatted="false">Veja Retratos, Documentos, Natureza e Melhores Fotos organizados 100% offline no seu celular.</string>
