    <!-- Daily Localized Notifications -->
    <string name="notif_channel_name">Promemoria giornalieri galleria</string>
    <string name="notif_channel_desc">Avvisi giornalieri per pulire duplicati, foto sfocate e liberare spazio.</string>
    <string name="notif_daily_title_1">Libera spazio con un solo tocco</string>
    <string name="notif_daily_msg_1">Avvia Pulizia Smart AI per trovare duplicati, foto sfocate e vecchi screenshot.</string>
    <string name="notif_daily_title_2">Foto duplicate nascoste in galleria?</string>
    <string name="notif_daily_msg_2">Le copie identiche occupano gigabyte senza farti accorgere. Scansiona e tieni solo l\'originale.</string>
    <string name="notif_daily_title_3">Conserva solo lo scatto migliore</string>
    <string name="notif_daily_msg_3">Tante foto simili a raffica? Lascia che l\'IA scelga la più nitida ed elimini le copie in eccesso.</string>
    <string name="notif_daily_title_4">Pulisci foto sfocate e mosse</string>
    <string name="notif_daily_msg_4">Individua automaticamente gli scatti fuori fuoco per mantenere la galleria ordinata.</string>
    <string name="notif_daily_title_5">Controlla il punteggio salute galleria</string>
    <string name="notif_daily_msg_5">Scopri il tuo punteggio IA di oggi e recupera spazio con suggerimenti mirati.</string>
    <string name="notif_daily_title_6">Troppi vecchi screenshot accumulati?</string>
    <string name="notif_daily_msg_6">Rivedi gli screenshot dimenticati da settimane e cancellali in pochi secondi.</string>
    <string name="notif_daily_title_7">Trova i video più pesanti</string>
    <string name="notif_daily_msg_7">I video grandi riempiono il telefono velocemente. Controlla i file più grandi per liberare spazio.</string>
    <string name="notif_daily_title_8">Pulisci i media ricevuti su WhatsApp</string>
    <string name="notif_daily_msg_8">Meme e video inoltrati si accumulano in fretta. Elimina ciò che non serve in un attimo.</string>
    <string name="notif_daily_title_9">Foto troppo scure o sovraesposte?</string>
    <string name="notif_daily_msg_9">L\'IA rileva gli scatti con cattiva illuminazione per aiutarti a riordinare senza fatica.</string>
    <string name="notif_daily_title_10">Esplora gli album ordinati dall\'IA</string>
    <string name="notif_daily_msg_10" formatted="false">Sfoglia Ritratti, Documenti, Natura e Scatti Migliori organizzati 100% offline sul tuo telefono.</string>
