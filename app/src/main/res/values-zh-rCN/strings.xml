    <!-- Daily Localized Notifications -->
    <string name="notif_channel_name">相册清理每日提醒</string>
    <string name="notif_channel_desc">每日提醒您清理重复照片、模糊照片并释放手机空间。</string>
    <string name="notif_daily_title_1">一键释放手机存储空间</string>
    <string name="notif_daily_msg_1">运行 AI 智能清理，快速找出重复照片、模糊照片和旧截图，轻松释放空间。</string>
    <string name="notif_daily_title_2">相册里藏着重复照片吗？</string>
    <string name="notif_daily_msg_2">完全相同的副本正悄悄占用大量空间。立即扫描，仅保留原始照片。</string>
    <string name="notif_daily_title_3">只保留最清晰的最佳照片</string>
    <string name="notif_daily_msg_3">连拍了很多相似照片？让本地 AI 自动挑出最佳画面，清理多余副本。</string>
    <string name="notif_daily_title_4">清理模糊与失焦照片</string>
    <string name="notif_daily_msg_4">自动识别拍糊和手抖的照片，让您的相册始终保持清爽整洁。</string>
    <string name="notif_daily_title_5">查看您的相册健康评分</string>
    <string name="notif_daily_msg_5">查看今日 AI 健康评分，按照智能建议快速回收被占用的存储空间。</string>
    <string name="notif_daily_title_6">旧截图越积越多？</string>
    <string name="notif_daily_msg_6">几秒钟内清理几周前不再需要的旧截图，让手机保持流畅。</string>
    <string name="notif_daily_title_7">找出占用空间的大体积视频</string>
    <string name="notif_daily_msg_7">大视频和下载文件最占空间，优先查看大文件即可迅速腾出空间。</string>
    <string name="notif_daily_title_8">清理 WhatsApp 转发媒体</string>
    <string name="notif_daily_msg_8">聊天保存的图片和视频很容易堆积，一键检查并清理不需要的媒体文件。</string>
    <string name="notif_daily_title_9">相册里有太暗或过曝的照片？</string>
    <string name="notif_daily_msg_9">AI 光线检测可自动找出光线不佳的照片，让您轻松完成整理。</string>
    <string name="notif_daily_title_10">浏览 AI 智能分类相册</string>
    <string name="notif_daily_msg_10" formatted="false">100% 本地离线查看自动分类的人像、文档、风景和精选最佳照片。</string>
