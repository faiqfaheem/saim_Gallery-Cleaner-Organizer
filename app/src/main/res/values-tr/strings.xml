    <!-- Daily Localized Notifications -->
    <string name="notif_channel_name">Günlük Galeri Hatırlatıcıları</string>
    <string name="notif_channel_desc">Yinelenen ve bulanık fotoğrafları temizlemek, depolama açmak için günlük bildirimler.</string>
    <string name="notif_daily_title_1">Tek Dokunuşla Depolama Alanı Açın</string>
    <string name="notif_daily_msg_1">Yinelenen fotoğrafları, bulanık kareleri ve eski ekran görüntülerini bulmak için AI Akıllı Temizlik çalıştırın.</string>
    <string name="notif_daily_title_2">Galerinizde Yinelenen Fotoğraflar mı Var?</string>
    <string name="notif_daily_msg_2">Birebir kopyalar gizlice yer kaplar. Şimdi tarayın ve yalnızca orijinali güvenle saklayın.</string>
    <string name="notif_daily_title_3">Yalnızca En Net En İyi Kareyi Saklayın</string>
    <string name="notif_daily_msg_3">Benzer seri çekimler mi var? Cihaz içi yapay zeka en iyi kareyi seçip fazlalıkları temizlesin.</string>
    <string name="notif_daily_title_4">Bulanık ve Odaksız Fotoğrafları Temizleyin</string>
    <string name="notif_daily_msg_4">Titrek ve bulanık çekimleri otomatik tespit ederek galerinizi tertemiz tutun.</string>
    <string name="notif_daily_title_5">Galeri Sağlık Puanınızı Kontrol Edin</string>
    <string name="notif_daily_msg_5">Günlük AI Sağlık Puanınızı görün ve akıllı önerilerle boşa harcanan alanı geri kazanın.</string>
    <string name="notif_daily_title_6">Eski Ekran Görüntüleri Birikiyor mu?</string>
    <string name="notif_daily_msg_6">Haftalar öncesinden kalan gereksiz ekran görüntülerini saniyeler içinde temizleyin.</string>
    <string name="notif_daily_title_7">Yer Kaplayan Büyük Videoları Bulun</string>
    <string name="notif_daily_msg_7">Büyük videolar ve indirilenler alanı hızla doldurur. En büyük dosyalara göz atıp yer açın.</string>
    <string name="notif_daily_title_8">WhatsApp Medyasını Temizleyin</string>
    <string name="notif_daily_msg_8">İletilen WhatsApp fotoğraf ve videoları hızla birikir. İstenmeyen medyayı kolayca silin.</string>
    <string name="notif_daily_title_9">Çok Karanlık veya Parlak Fotoğraflar mı Var?</string>
    <string name="notif_daily_msg_9">AI kötü ışık algılama karanlık ve soluk fotoğrafları bulur, zahmetsizce düzenlemenizi sağlar.</string>
    <string name="notif_daily_title_10">AI Düzenli Albümlerinizi Keşfedin</string>
    <string name="notif_daily_msg_10">Portreler, Belgeler, Doğa ve En İyi Kareler tamamen çevrimdışı olarak cihazınızda düzenlendi.</string>
