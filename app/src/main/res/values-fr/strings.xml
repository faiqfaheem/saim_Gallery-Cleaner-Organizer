    <string name="notif_daily_title_1">Libérez de l\'espace en un geste</string>
    <string name="notif_daily_msg_1">Lancez le Nettoyage IA pour repérer doublons, photos floues et vieilles captures d\'écran.</string>
    <string name="notif_daily_title_2">Des photos en double dans votre galerie ?</string>
    <string name="notif_daily_msg_2">Les copies identiques saturent votre stockage. Scannez et ne gardez que l\'originale en sécurité.</string>
