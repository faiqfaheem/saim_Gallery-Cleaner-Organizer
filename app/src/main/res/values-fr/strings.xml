    <string name="notif_daily_msg_4">Repérez automatiquement les clichés ratés pour garder une galerie propre et soignée.</string>
    <string name="notif_daily_title_5">Vérifiez le score de santé de votre galerie</string>
    <string name="notif_daily_msg_5">Consultez votre score IA quotidien et récupérez de l\'espace grâce aux suggestions intelligentes.</string>
    <string name="notif_daily_title_6">Trop de vieilles captures d\'écran ?</string>
    <string name="notif_daily_msg_6">Triez les captures oubliées depuis des semaines et supprimez-les en quelques secondes.</string>
