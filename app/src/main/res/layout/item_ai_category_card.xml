<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_148sdp"
    android:layout_margin="@dimen/_5sdp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_variant"
    app:cardCornerRadius="@dimen/_18sdp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="0.75dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_scrim_card" />

        <FrameLayout
            android:id="@+id/fl_cat_icon"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/_10sdp"
            android:background="@drawable/bg_glass_circle">

            <ImageView
                android:id="@+id/iv_cat_icon"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="#FFFFFF"
                tools:src="@drawable/ic_portrait" />
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_cat_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/_10sdp"
            android:background="@drawable/bg_glass_pill"
            android:paddingHorizontal="@dimen/_9sdp"
            android:paddingVertical="@dimen/_3sdp"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            tools:text="42" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_11sdp"
            android:paddingBottom="@dimen/_11sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_cat_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                tools:text="Portraits" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_cat_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hero_ring"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                tools:text="124 MB" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
