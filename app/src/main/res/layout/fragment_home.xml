<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/nested_scroll">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_16sdp"
            android:paddingEnd="@dimen/_16sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:text="@string/home_title"
                android:textColor="@color/on_background"
                android:textSize="@dimen/_19ssp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_20sdp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_14sdp">

            <!-- Storage Warning Banner (shown only when storage >= 85%) -->
            <LinearLayout
                android:id="@+id/banner_storage_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:background="@drawable/bg_warning_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_storage"
                    app:tint="@color/warning" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/storage_almost_full_warning"
                    android:textColor="@color/warning"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Studio Darkroom Storage Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                app:cardCornerRadius="@dimen/_22sdp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_storage_card"
                    android:orientation="vertical"
                    android:padding="@dimen/_17sdp">

                    <!-- Top Row: Storage Readout + Luminous Teal Ring -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.03"
                                android:text="@string/internal_storage"
                                android:textColor="#A6FFFFFF"
                                android:textSize="@dimen/_10ssp" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_storage_used"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:letterSpacing="-0.02"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/_27ssp"
                                android:textStyle="bold"
                                tools:text="14.2 GB" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_storage_of"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:textColor="#B8FFFFFF"
                                android:textSize="@dimen/_10ssp"
                                tools:text="of 64 GB · 49.8 GB free" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="@dimen/_74sdp"
                            android:layout_height="@dimen/_74sdp">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progress_circle"
                                android:layout_width="@dimen/_74sdp"
                                android:layout_height="@dimen/_74sdp"
                                android:indeterminate="false"
                                android:max="100"
                                android:progress="22"
                                app:indicatorColor="@color/hero_ring"
                                app:indicatorInset="0dp"
                                app:indicatorSize="@dimen/_74sdp"
                                app:trackColor="#26FFFFFF"
                                app:trackCornerRadius="@dimen/_4sdp"
                                app:trackThickness="@dimen/_6sdp"
                                tools:progress="22" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tv_usage_percent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#FFFFFF"
                                    android:textSize="@dimen/_14ssp"
                                    android:textStyle="bold"
                                    tools:text="22%" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_used"
                                    android:textColor="#A6FFFFFF"
                                    android:textSize="@dimen/_8ssp" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Tactile Glass Stat Pills Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_14sdp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_hero_stat_pill"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/_8sdp">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_photo_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/_14ssp"
                                android:textStyle="bold"
                                tools:text="1,248" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_photos"
                                android:textColor="#B0FFFFFF"
                                android:textSize="@dimen/_9ssp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/_3sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_hero_stat_pill"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/_8sdp">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_video_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/_14ssp"
                                android:textStyle="bold"
                                tools:text="86" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/videos"
                                android:textColor="#B0FFFFFF"
                                android:textSize="@dimen/_9ssp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_hero_stat_pill"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/_8sdp">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_junk_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/hero_ring"
                                android:textSize="@dimen/_14ssp"
                                android:textStyle="bold"
                                tools:text="340" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_files"
                                android:textColor="#B0FFFFFF"
                                android:textSize="@dimen/_9ssp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Photo-Stack AI Smart Clean Spotlight Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ai_smart_clean"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/_18sdp"
                app:cardElevation="1dp"
                app:strokeColor="@color/ai_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ai_spotlight"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_12sdp">

                    <!-- Overlapping Mini Photo Stack / AI Sparkle Fallback -->
                    <FrameLayout
                        android:layout_width="@dimen/_62sdp"
                        android:layout_height="@dimen/_44sdp"
                        android:layout_marginEnd="@dimen/_12sdp">

                        <!-- Fallback AI Icon Badge -->
                        <FrameLayout
                            android:id="@+id/fl_ai_fallback_icon"
                            android:layout_width="@dimen/_44sdp"
                            android:layout_height="@dimen/_44sdp"
                            android:layout_gravity="center_vertical|start"
                            android:background="@drawable/bg_ai_pill">

                            <ImageView
                                android:layout_width="@dimen/_22sdp"
                                android:layout_height="@dimen/_22sdp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ai_sparkle"
                                app:tint="@color/ai_accent" />
                        </FrameLayout>

                        <!-- Live 3-Photo Overlapping Stack -->
                        <FrameLayout
                            android:id="@+id/fl_ai_photo_stack"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_ai_thumb_3"
                                android:layout_width="@dimen/_34sdp"
                                android:layout_height="@dimen/_38sdp"
                                android:layout_gravity="center_vertical|end"
                                app:cardCornerRadius="@dimen/_9sdp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/card_background"
                                app:strokeWidth="1.5dp">

                                <ImageView
                                    android:id="@+id/iv_ai_thumb_3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@null"
                                    android:scaleType="centerCrop" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_ai_thumb_2"
                                android:layout_width="@dimen/_36sdp"
                                android:layout_height="@dimen/_40sdp"
                                android:layout_gravity="center"
                                app:cardCornerRadius="@dimen/_9sdp"
                                app:cardElevation="1dp"
                                app:strokeColor="@color/card_background"
                                app:strokeWidth="1.5dp">

                                <ImageView
                                    android:id="@+id/iv_ai_thumb_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@null"
                                    android:scaleType="centerCrop" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_ai_thumb_1"
                                android:layout_width="@dimen/_38sdp"
                                android:layout_height="@dimen/_42sdp"
                                android:layout_gravity="center_vertical|start"
                                app:cardCornerRadius="@dimen/_10sdp"
                                app:cardElevation="2dp"
                                app:strokeColor="@color/card_background"
                                app:strokeWidth="1.5dp">

                                <ImageView
                                    android:id="@+id/iv_ai_thumb_1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@null"
                                    android:scaleType="centerCrop" />
                            </com.google.android.material.card.MaterialCardView>
                        </FrameLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_smart_clean_title"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/_13ssp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_ai_clean_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ai_smart_clean_banner_desc"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/_10ssp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_health_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:background="@drawable/bg_ai_pill"
                        android:paddingHorizontal="@dimen/_9sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        android:text="@string/ai_badge"
                        android:textColor="@color/ai_accent"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Scan Progress Pill (visible only while scanning) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_scan_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_11sdp">

                    <ProgressBar
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_scan_message"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/state_scanning"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/_11ssp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_scan_percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:background="@drawable/bg_ai_pill"
                                android:paddingHorizontal="@dimen/_7sdp"
                                android:paddingVertical="@dimen/_2sdp"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/_10ssp"
                                android:textStyle="bold"
                                tools:text="64%" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progress_scan"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_4sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:indeterminate="false"
                            android:max="100"
                            android:progressBackgroundTint="@color/surface_variant"
                            android:progressTint="@color/primary" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_scan_counts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/_9ssp"
                            tools:text="160 / 250 done · 90 left" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Title -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginTop="@dimen/_18sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:text="@string/section_clean_up"
                android:textColor="@color/on_background"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <!-- 2-Column Visual Photo-Album Feature Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-5dp"
                android:columnCount="2"
                android:useDefaultMargins="false">

                <include
                    android:id="@+id/card_ai_organizer"
                    layout="@layout/item_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_126sdp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="5dp" />

                <include
                    android:id="@+id/card_dark_photos"
                    layout="@layout/item_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_126sdp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="5dp" />

                <include
                    android:id="@+id/card_large_files"
                    layout="@layout/item_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_126sdp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="5dp" />

                <include
                    android:id="@+id/card_duplicates"
                    layout="@layout/item_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_126sdp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="5dp" />

                <include
                    android:id="@+id/card_similar"
                    layout="@layout/item_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_126sdp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="5dp" />

                <include
                    android:id="@+id/card_blurry"
                    layout="@layout/item_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_126sdp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="5dp" />

                <include
                    android:id="@+id/card_screenshots"
                    layout="@layout/item_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_126sdp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="5dp" />

                <include
                    android:id="@+id/card_videos"
                    layout="@layout/item_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_126sdp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="5dp" />

                <include
                    android:id="@+id/card_downloads"
                    layout="@layout/item_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_126sdp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="5dp" />

                <include
                    android:id="@+id/card_whatsapp"
                    layout="@layout/item_feature_card"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_126sdp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_margin="5dp" />
            </GridLayout>

            <!-- Stylized Trash Recovery Card (Android 12+) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_trash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/_18sdp"
                app:cardElevation="1dp"
                app:strokeColor="@color/trash_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_trash_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_13sdp">

                    <FrameLayout
                        android:layout_width="@dimen/_38sdp"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_marginEnd="@dimen/_12sdp"
                        android:background="@drawable/bg_trash_pill">

                        <ImageView
                            android:layout_width="@dimen/_19sdp"
                            android:layout_height="@dimen/_19sdp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_delete"
                            app:tint="@color/error" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_view_trash"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/_13ssp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/trash_auto_delete_banner"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/_10ssp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_trash_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:background="@drawable/bg_trash_pill"
                        android:paddingHorizontal="@dimen/_8sdp"
