<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_6sdp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_navigate_back"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_background" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_smart_clean_title"
                    android:textColor="@color/on_background"
                    android:textSize="@dimen/_16ssp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_on_device_subtitle"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_rescan"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_rescan"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_radar"
                app:tint="@color/primary" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Loading State -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_28sdp"
            android:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_76sdp"
                android:layout_height="@dimen/_76sdp"
                app:cardBackgroundColor="@color/ai_surface"
                app:cardCornerRadius="@dimen/_24sdp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="@dimen/_38sdp"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ai_sparkle"
                    app:tint="@color/ai_accent" />
            </com.google.android.material.card.MaterialCardView>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/ai_analyzing_title"
                android:textColor="@color/on_background"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center"
                android:text="@string/ai_analyzing_desc"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_11ssp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_loading_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:textColor="@color/ai_accent"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold"
                tools:text="58%" />

            <ProgressBar
                android:id="@+id/progress_ai_scan"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="@dimen/_200sdp"
                android:layout_height="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:max="100"
                android:progressBackgroundTint="@color/surface_variant"
                android:progressTint="@color/ai_accent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_loading_counts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_11ssp"
                tools:text="261 / 450 done · 189 left" />
        </LinearLayout>

        <!-- Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_88sdp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingTop="@dimen/_8sdp">

                <!-- AI Health Score Hero Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_16sdp"
                    app:cardCornerRadius="@dimen/_20sdp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ai_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/_18sdp">

                        <FrameLayout
                            android:layout_width="@dimen/_76sdp"
                            android:layout_height="@dimen/_76sdp"
                            android:layout_marginEnd="@dimen/_16sdp">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progress_health"
                                android:layout_width="@dimen/_76sdp"
                                android:layout_height="@dimen/_76sdp"
                                android:max="100"
                                app:indicatorColor="#FFFFFF"
                                app:indicatorInset="0dp"
                                app:indicatorSize="@dimen/_76sdp"
                                app:trackColor="#33FFFFFF"
                                app:trackThickness="@dimen/_6sdp"
                                tools:progress="82" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_health_score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/_18ssp"
                                android:textStyle="bold"
                                tools:text="82" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ai_health_score_label"
                                android:textColor="#CCFFFFFF"
                                android:textSize="@dimen/_10ssp" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_health_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/_17ssp"
                                android:textStyle="bold"
                                tools:text="Good Condition" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_reclaimable_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:textColor="#DDFFFFFF"
                                android:textSize="@dimen/_11ssp"
                                tools:text="245 MB can be freed safely" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Recommendations Header -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_rec_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:text="@string/ai_recommendations_title"
                    android:textColor="@color/on_background"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold" />

                <!-- Recommendations Container -->
                <LinearLayout
                    android:id="@+id/ll_recommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- All Clean State -->
                <LinearLayout
                    android:id="@+id/layout_all_clean"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/_28sdp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/success" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="@string/ai_gallery_optimized_title"
                        android:textColor="@color/on_background"
                        android:textSize="@dimen/_15ssp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:gravity="center"
                        android:text="@string/ai_gallery_optimized_desc"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- One-Tap AI Clean CTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ai_clean_now"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_14sdp"
            android:text="@string/ai_clean_now"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/ai_accent"
            app:cornerRadius="@dimen/_23sdp"
            app:icon="@drawable/ic_ai_sparkle"
            app:iconGravity="textStart"
            app:iconTint="@android:color/white"
            tools:visibility="visible" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
