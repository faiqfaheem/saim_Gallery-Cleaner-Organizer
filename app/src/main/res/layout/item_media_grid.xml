<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_2sdp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="@dimen/_10sdp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="@dimen/_1sdp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Thumbnail Image -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_120sdp"
            android:background="@color/surface_variant"
            android:contentDescription="@string/cd_file_thumbnail"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_image_placeholder" />

        <!-- Top Scrim -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:layout_gravity="top"
            android:background="@drawable/gradient_scrim_top" />

        <!-- Bottom Scrim -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_scrim_bottom" />

        <!-- Blurry Badge -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/chip_blurry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/_5sdp"
            android:background="@drawable/bg_blurry_badge"
            android:paddingStart="@dimen/_6sdp"
            android:paddingTop="@dimen/_2sdp"
            android:paddingEnd="@dimen/_6sdp"
            android:paddingBottom="@dimen/_2sdp"
            android:text="@string/badge_blurry"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- AI Best Shot / Keep Badge -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/chip_keep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/_5sdp"
            android:background="@drawable/bg_best_shot_badge"
            android:paddingStart="@dimen/_6sdp"
            android:paddingTop="@dimen/_2sdp"
            android:paddingEnd="@dimen/_6sdp"
            android:paddingBottom="@dimen/_2sdp"
            android:text="@string/badge_keep"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Video Play Center Icon -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_play_icon"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_video"
            android:visibility="gone"
            app:tint="#CCFFFFFF" />

        <!-- Video Duration -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/_5sdp"
            android:background="@drawable/bg_badge"
            android:paddingStart="@dimen/_5sdp"
            android:paddingTop="@dimen/_2sdp"
            android:paddingEnd="@dimen/_5sdp"
            android:paddingBottom="@dimen/_2sdp"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="1:24"
            tools:visibility="visible" />

        <!-- File Size -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/_5sdp"
            android:background="@drawable/bg_badge"
            android:paddingStart="@dimen/_5sdp"
            android:paddingTop="@dimen/_2sdp"
            android:paddingEnd="@dimen/_5sdp"
            android:paddingBottom="@dimen/_2sdp"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_9ssp"
            tools:text="4.2 MB" />

        <!-- Selection Tint Overlay -->
        <View
            android:id="@+id/selection_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/selection_overlay"
            android:visibility="gone" />

        <!-- Selected Card Border Ring -->
        <View
            android:id="@+id/view_selected_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_selected_card"
            android:visibility="gone" />

        <!-- Checkbox Container -->
        <FrameLayout
            android:id="@+id/fl_checkbox"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/_4sdp"
            android:background="@drawable/bg_checkbox_container"
            android:padding="@dimen/_1sdp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_select"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_gravity="center"
                android:background="@null"
                app:buttonTint="@color/primary"
                app:useMaterialThemeColors="false" />

        </FrameLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
