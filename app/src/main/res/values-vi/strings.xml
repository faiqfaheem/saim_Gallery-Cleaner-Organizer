    <!-- Daily Localized Notifications -->
    <string name="notif_channel_name">Nhắc nhở dọn thư viện hàng ngày</string>
    <string name="notif_channel_desc">Nhắc nhở hàng ngày giúp dọn ảnh trùng, ảnh mờ và giải phóng dung lượng.</string>
    <string name="notif_daily_title_1">Giải phóng dung lượng chỉ với một chạm</string>
    <string name="notif_daily_msg_1">Chạy Dọn Dẹp AI Thông Minh để tìm ảnh trùng lặp, ảnh mờ và ảnh chụp màn hình cũ.</string>
    <string name="notif_daily_title_2">Có ảnh trùng lặp ẩn trong thư viện?</string>
    <string name="notif_daily_msg_2">Các bản sao giống hệt nhau âm thầm chiếm nhiều GB. Quét ngay và chỉ giữ lại ảnh gốc an toàn.</string>
    <string name="notif_daily_title_3">Chỉ giữ lại bức ảnh sắc nét nhất</string>
    <string name="notif_daily_msg_3">Chụp liên tiếp nhiều tấm giống nhau? Để AI chọn tấm đẹp nhất và xóa các bản thừa.</string>
    <string name="notif_daily_title_4">Dọn sạch ảnh mờ và mất nét</string>
    <string name="notif_daily_msg_4">Tự động phát hiện ảnh rung, mờ để thư viện ảnh của bạn luôn gọn gàng và sắc nét.</string>
    <string name="notif_daily_title_5">Kiểm tra Điểm Sức Khỏe Thư Viện</string>
    <string name="notif_daily_msg_5">Xem điểm sức khỏe AI hôm nay và lấy lại dung lượng với các gợi ý dọn dẹp thông minh.</string>
    <string name="notif_daily_title_6">Ảnh chụp màn hình cũ đang chất đống?</string>
    <string name="notif_daily_msg_6">Xem lại các ảnh chụp màn hình từ nhiều tuần trước và xóa gọn chỉ trong vài giây.</string>
    <string name="notif_daily_title_7">Tìm các video dung lượng lớn</string>
    <string name="notif_daily_msg_7">Video nặng và tệp tải xuống làm đầy máy rất nhanh. Kiểm tra tệp lớn nhất để giải phóng ngay.</string>
    <string name="notif_daily_title_8">Dọn dẹp tệp phương tiện WhatsApp</string>
    <string name="notif_daily_msg_8">Ảnh và video chuyển tiếp từ WhatsApp tăng rất nhanh. Dọn bỏ nội dung không cần thiết dễ dàng.</string>
    <string name="notif_daily_title_9">Có ảnh quá tối hoặc cháy sáng?</string>
    <string name="notif_daily_msg_9">AI phát hiện ánh sáng kém giúp lọc nhanh ảnh tối hoặc lóa để bạn dọn dẹp nhẹ nhàng.</string>
    <string name="notif_daily_title_10">Khám phá Album được AI sắp xếp</string>
    <string name="notif_daily_msg_10" formatted="false">Xem Chân dung, Tài liệu, Thiên nhiên và Ảnh Đẹp Nhất được phân loại 100% ngoại tuyến trên máy.</string>
