    <!-- Daily Localized Notifications -->
    <string name="notif_channel_name">Avisos diarios de limpieza</string>
    <string name="notif_channel_desc">Recordatorios diarios para limpiar duplicados, fotos borrosas y liberar espacio.</string>
    <string name="notif_daily_title_1">Libera espacio con un solo toque</string>
    <string name="notif_daily_msg_1">Ejecuta Limpieza Inteligente AI para detectar duplicados, fotos borrosas y capturas antiguas.</string>
    <string name="notif_daily_title_2">¿Fotos duplicadas ocupando espacio?</string>
    <string name="notif_daily_msg_2">Las copias idénticas llenan tu almacenamiento sin darte cuenta. Escanea y conserva solo la original.</string>
    <string name="notif_daily_title_3">Quédate solo con la mejor foto</string>
    <string name="notif_daily_msg_3">¿Muchas fotos en ráfaga? Deja que la IA elija la toma más nítida y elimine las sobrantes.</string>
    <string name="notif_daily_title_4">Elimina fotos borrosas y desenfocadas</string>
    <string name="notif_daily_msg_4">Detecta automáticamente tomas movidas para mantener tu galería impecable y ordenada.</string>
    <string name="notif_daily_title_5">Revisa la puntuación de salud de tu galería</string>
    <string name="notif_daily_msg_5">Consulta tu estado diario con IA y recupera espacio con recomendaciones inteligentes.</string>
    <string name="notif_daily_title_6">¿Se acumulan las capturas de pantalla?</string>
    <string name="notif_daily_msg_6">Revisa capturas antiguas que ya no necesitas y bórralas en segundos.</string>
    <string name="notif_daily_title_7">Encuentra videos pesados fácilmente</string>
    <string name="notif_daily_msg_7">Los videos grandes llenan tu teléfono rápido. Revisa los archivos más pesados para liberar espacio.</string>
    <string name="notif_daily_title_8">Limpia archivos multimedia de WhatsApp</string>
    <string name="notif_daily_msg_8">Memes y videos reenviados se acumulan rápido. Limpia lo que no necesitas en un momento.</string>
    <string name="notif_daily_title_9">¿Fotos muy oscuras o sobreexpuestas?</string>
    <string name="notif_daily_msg_9">La detección de mala iluminación con IA localiza fotos oscuras o quemadas para limpiarlas fácil.</string>
    <string name="notif_daily_title_10">Explora tus álbumes organizados por IA</string>
    <string name="notif_daily_msg_10" formatted="false">Mira Retratos, Documentos, Naturaleza y Mejores Fotos ordenados 100% sin conexión en tu dispositivo.</string>
