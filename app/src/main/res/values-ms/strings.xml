    <!-- Daily Localized Notifications -->
    <string name="notif_channel_name">Peringatan Harian Pembersih Galeri</string>
    <string name="notif_channel_desc">Peringatan harian untuk membersihkan foto pendua, kabur dan mengosongkan storan.</string>
    <string name="notif_daily_title_1">Kosongkan Storan Dengan Satu Ketikan</string>
    <string name="notif_daily_msg_1">Jalankan AI Smart Clean untuk mengesan foto pendua, gambar kabur dan tangkapan skrin lama.</string>
    <string name="notif_daily_title_2">Ada Foto Pendua Dalam Galeri Anda?</string>
    <string name="notif_daily_msg_2">Salinan serupa diam-diam memenuhi ruang. Imbas sekarang dan simpan foto asal sahaja dengan selamat.</string>
    <string name="notif_daily_title_3">Simpan Hanya Foto Terbaik yang Tajam</string>
    <string name="notif_daily_msg_3">Banyak foto berturut-turut yang serupa? Biarkan AI memilih syot terbaik dan buang lebihan.</string>
    <string name="notif_daily_title_4">Bersihkan Foto Kabur &amp; Tidak Fokus</string>
    <string name="notif_daily_msg_4">Kesan gambar bergegar atau kabur secara automatik supaya galeri anda kekal kemas.</string>
    <string name="notif_daily_title_5">Semak Skor Kesihatan Galeri Anda</string>
    <string name="notif_daily_msg_5">Lihat Skor Kesihatan AI hari ini dan dapatkan semula ruang terbuang dengan cadangan pintar.</string>
    <string name="notif_daily_title_6">Tangkapan Skrin Lama Semakin Bertimbun?</string>
    <string name="notif_daily_msg_6">Semak tangkapan skrin lama yang tidak lagi diperlukan dan padamkannya dalam beberapa saat.</string>
    <string name="notif_daily_title_7">Cari Video Besar yang Memenuhi Ruang</string>
    <string name="notif_daily_msg_7">Video dan muat turun bersaiz besar cepat memenuhi telefon. Semak fail terbesar dahulu.</string>
    <string name="notif_daily_title_8">Bersihkan Media WhatsApp yang Dimajukan</string>
    <string name="notif_daily_msg_8">Foto dan video WhatsApp cepat terkumpul. Padam media yang tidak diingini dengan mudah.</string>
    <string name="notif_daily_title_9">Foto Terlalu Gelap atau Terlampau Terang?</string>
    <string name="notif_daily_msg_9">Pengesanan pencahayaan AI mencari gambar gelap atau pudar supaya mudah dibersihkan.</string>
    <string name="notif_daily_title_10">Terokai Album Disusun AI Anda</string>
    <string name="notif_daily_msg_10" formatted="false">Lihat Potret, Dokumen, Alam Semula Jadi dan Syot Terbaik yang disusun 100% luar talian pada peranti anda.</string>
