    <!-- Daily Localized Notifications -->
    <string name="notif_channel_name">Tägliche Galerie-Erinnerungen</string>
    <string name="notif_channel_desc">Tägliche Tipps zum Entfernen von Duplikaten, unscharfen Fotos und zum Freigeben von Speicher.</string>
    <string name="notif_daily_title_1">Speicherplatz mit einem Tipp freigeben</string>
    <string name="notif_daily_msg_1">Starte KI Smart Clean, um Duplikate, unscharfe Bilder und alte Screenshots zu entfernen.</string>
    <string name="notif_daily_title_2">Versteckte doppelte Fotos in der Galerie?</string>
    <string name="notif_daily_msg_2">Identische Kopien belegen unbemerkt wertvollen Speicher. Jetzt scannen und nur das Original behalten.</string>
    <string name="notif_daily_title_3">Behalte nur die schärfste Aufnahme</string>
    <string name="notif_daily_msg_3">Viele Serienbilder gemacht? Lass die lokale KI das beste Foto auswählen und den Rest entfernen.</string>
    <string name="notif_daily_title_4">Unscharfe &amp; verwackelte Fotos bereinigen</string>
    <string name="notif_daily_msg_4">Erkenne unscharfe Schnappschüsse automatisch für eine saubere und ordentliche Galerie.</string>
    <string name="notif_daily_title_5">Prüfe deinen Galerie-Gesundheitswert</string>
    <string name="notif_daily_msg_5">Sieh dir deinen täglichen KI-Score an und gewinne Speicherplatz mit smarten Empfehlungen zurück.</string>
    <string name="notif_daily_title_6">Sammeln sich alte Screenshots an?</string>
    <string name="notif_daily_msg_6">Überprüfe vergessene Bildschirmfotos und lösche sie in wenigen Sekunden.</string>
    <string name="notif_daily_title_7">Große Videos &amp; Speicherfresser finden</string>
    <string name="notif_daily_msg_7">Große Videos und Downloads füllen dein Handy schnell. Prüfe die größten Dateien zuerst.</string>
    <string name="notif_daily_title_8">Weitergeleitete WhatsApp-Medien aufräumen</string>
    <string name="notif_daily_msg_8">Memes und Videos aus Chats summieren sich schnell. Entferne Unnötiges mit einem Blick.</string>
    <string name="notif_daily_title_9">Zu dunkle oder überbelichtete Fotos?</string>
    <string name="notif_daily_msg_9">Die KI-Belichtungserkennung findet schlecht beleuchtete Bilder für müheloses Aufräumen.</string>
    <string name="notif_daily_title_10">Entdecke deine KI-sortierten Alben</string>
    <string name="notif_daily_msg_10" formatted="false">Durchstöbere Porträts, Dokumente, Natur und beste Aufnahmen – 100 % offline auf deinem Gerät.</string>
