    <!-- Daily Localized Notifications -->
    <string name="notif_channel_name">Pengingat Harian Pembersih Galeri</string>
    <string name="notif_channel_desc">Pengingat harian untuk membersihkan duplikat, foto buram, dan menghemat penyimpanan.</string>
    <string name="notif_daily_title_1">Kosongkan Penyimpanan Sekali Ketuk</string>
    <string name="notif_daily_msg_1">Jalankan AI Smart Clean untuk menemukan foto duplikat, buram, dan tangkapan layar lama.</string>
    <string name="notif_daily_title_2">Ada Foto Duplikat di Galeri Anda?</string>
    <string name="notif_daily_msg_2">Salinan identik diam-diam memenuhi ruang. Pindai sekarang dan simpan foto aslinya saja.</string>
    <string name="notif_daily_title_3">Simpan Hanya Foto Terbaik yang Tajam</string>
    <string name="notif_daily_msg_3">Banyak foto beruntun serupa? Biarkan AI memilih foto terbaik dan hapus sisanya.</string>
    <string name="notif_daily_title_4">Bersihkan Foto Buram &amp; Tidak Fokus</string>
    <string name="notif_daily_msg_4">Deteksi otomatis foto goyang atau buram agar galeri Anda selalu rapi dan jernih.</string>
    <string name="notif_daily_title_5">Cek Skor Kesehatan Galeri Anda</string>
    <string name="notif_daily_msg_5">Lihat Skor Kesehatan AI hari ini dan bebaskan ruang terbuang dengan saran cerdas.</string>
    <string name="notif_daily_title_6">Tangkapan Layar Lama Menumpuk?</string>
    <string name="notif_daily_msg_6">Tinjau screenshot lama yang tak terpakai dan bersihkan dalam hitungan detik.</string>
    <string name="notif_daily_title_7">Temukan Video Besar Pemakan Ruang</string>
    <string name="notif_daily_msg_7">Video dan unduhan besar cepat memenuhi ponsel. Periksa file terbesar untuk menghemat ruang.</string>
    <string name="notif_daily_title_8">Bersihkan Media WhatsApp yang Diteruskan</string>
    <string name="notif_daily_msg_8">Foto dan video WhatsApp cepat menumpuk. Hapus media yang tidak diperlukan dengan cepat.</string>
    <string name="notif_daily_title_9">Foto Terlalu Gelap atau Terlalu Terang?</string>
    <string name="notif_daily_msg_9">Deteksi pencahayaan AI menemukan foto gelap atau silau agar mudah dirapikan.</string>
    <string name="notif_daily_title_10">Jelajahi Album Teratur AI Anda</string>
    <string name="notif_daily_msg_10" formatted="false">Lihat Potret, Dokumen, Alam, dan Foto Terbaik yang disortir 100% offline di perangkat Anda.</string>
