    <!-- Daily Localized Notifications -->
    <string name="notif_channel_name">Gallery Cleaner Daily Tips</string>
    <string name="notif_channel_desc">Daily reminders to clean duplicates, blurry shots, and free up storage.</string>
    <string name="notif_daily_title_1">Free Up Storage in One Tap</string>
    <string name="notif_daily_msg_1">Run AI Smart Clean to spot duplicate photos, blurry shots, and old screenshots eating up space.</string>
    <string name="notif_daily_title_2">Duplicate Photos Hiding in Your Gallery?</string>
    <string name="notif_daily_msg_2">Exact copies quietly fill up gigabytes. Scan now and keep only the original photo safely.</string>
    <string name="notif_daily_title_3">Keep Only Your Sharpest Best Shot</string>
    <string name="notif_daily_msg_3">Took multiple burst photos? Let on-device AI pick the sharpest shot and remove the extra copies.</string>
    <string name="notif_daily_title_4">Clear Out Blurry &amp; Out-of-Focus Photos</string>
    <string name="notif_daily_msg_4">Clean up shaky or blurry camera shots automatically so your gallery stays crisp and organized.</string>
    <string name="notif_daily_title_5">Check Your Gallery Health Score</string>
    <string name="notif_daily_msg_5">See your daily AI Health Score and reclaim wasted storage with prioritized smart recommendations.</string>
    <string name="notif_daily_title_6">Old Screenshots Piling Up?</string>
    <string name="notif_daily_msg_6">Review forgotten screenshots from weeks ago and clear them out in seconds to keep your phone fast.</string>
    <string name="notif_daily_title_7">Find Heavy Videos Taking Up Space</string>
    <string name="notif_daily_msg_7">Large videos and downloads can quickly fill your phone. Review the biggest files first to free space fast.</string>
    <string name="notif_daily_title_8">Clean Forwarded WhatsApp Media</string>
    <string name="notif_daily_msg_8">Memes, videos, and forwarded photos from WhatsApp add up fast. Clean unwanted media with one quick check.</string>
    <string name="notif_daily_title_9">Dark or Overexposed Shots in Your Camera Roll?</string>
    <string name="notif_daily_msg_9">AI Bad Lighting detection spots overly dark or washed-out photos so you can tidy up effortlessly.</string>
    <string name="notif_daily_title_10">Explore Your AI-Organized Albums</string>
    <string name="notif_daily_msg_10" formatted="false">Browse Portraits, Documents, Nature, and Best Shots auto-sorted privately on your device — 100% offline.</string>
